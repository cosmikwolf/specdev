#!/bin/sh
# resolve-context — emit the resolved context for the current project.
#
# Standalone helper (not auto-invoked by skills — those use the env-export
# preamble in shared/plugin-root-preamble.md). Run manually when you want a
# rendered view of the resolved schema/domain/language paths a project will use.
#
# Delegates to `specdev-analyzer resolve`, which implements the full
# resolution chain:
#   1. explicit paths in `spec.toml` [paths.overrides]
#   2. `./.specdev/<kind>/<name>/`
#   3. plugin defaults (under $CLAUDE_PLUGIN_ROOT)
#
# Emits markdown on stdout.

set -e

ANALYZER_BIN="${ANALYZER_BIN:-specdev-analyzer}"

if [ -n "${CLAUDE_PLUGIN_ROOT}" ]; then
    PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT}"
else
    SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
    PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
fi

if ! command -v "${ANALYZER_BIN}" >/dev/null 2>&1; then
    cat <<EOF
## Spec Context

**ERROR:** \`${ANALYZER_BIN}\` is not on PATH.

Install from a local checkout of \`specdev-analyzer\` (no org access
needed):

    cargo install --path <analyzer-checkout>

Or from the private repository, replacing \`<org>\` with the GitHub
organization you were granted access to:

    cargo install --git https://github.com/<org>/specdev-analyzer --tag v0.6.0

Or set \`ANALYZER_BIN\` to an absolute path.

If it IS installed and a command reports \`MANIFEST-002\`, or a
\`MANIFEST-001\` naming a file under the plugin tree, the analyzer is older
than the plugin. Re-install it with whichever command you used above, plus \`--force\`.
EOF
    exit 0
fi

exec "${ANALYZER_BIN}" resolve --project "$(pwd)" --plugin-root "${PLUGIN_ROOT}" --allow-missing
