#!/bin/sh
# resolve-context — Placeholder resolver for the specdev plugin.
#
# Phase 1 scaffolding: this script only returns plugin defaults.
# Phase 7 will flesh out the full resolution chain per decision D13:
#   1. explicit paths in `spec.toml` [paths.overrides]
#   2. `./.specdev/<kind>/<name>/`
#   3. plugin defaults (under CLAUDE_PLUGIN_ROOT)
#
# Called by every SKILL.md via:
#   !`${CLAUDE_PLUGIN_ROOT}/scripts/resolve-context`

set -e

if [ -n "${CLAUDE_PLUGIN_ROOT}" ]; then
    PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT}"
else
    SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
    PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
fi

# Walk up from cwd to find spec.toml
SPEC_TOML=""
SEARCH_DIR="$(pwd)"
while [ "${SEARCH_DIR}" != "/" ]; do
    if [ -f "${SEARCH_DIR}/spec.toml" ]; then
        SPEC_TOML="${SEARCH_DIR}/spec.toml"
        break
    fi
    SEARCH_DIR="$(dirname "${SEARCH_DIR}")"
done

if [ -z "${SPEC_TOML}" ]; then
    echo "## Spec Context"
    echo ""
    echo "WARNING: No spec.toml found. Run /spec-init to create one."
    echo ""
    echo "- Plugin root: ${PLUGIN_ROOT}"
    echo "- Domain: (unknown)"
    echo "- Language: (unknown)"
    exit 0
fi

PROJECT_ROOT="$(dirname "${SPEC_TOML}")"

DOMAIN=$(grep -E '^\s*domain\s*=' "${SPEC_TOML}" | head -1 | sed 's/.*"\([^"]*\)".*/\1/')
LANGUAGE=$(grep -E '^\s*language\s*=' "${SPEC_TOML}" | head -1 | sed 's/.*"\([^"]*\)".*/\1/')
SPEC_VERSION=$(grep -E '^\s*spec_version\s*=' "${SPEC_TOML}" | head -1 | sed 's/.*"\([^"]*\)".*/\1/')
DOMAIN="${DOMAIN:-(unknown)}"
LANGUAGE="${LANGUAGE:-(unknown)}"
SPEC_VERSION="${SPEC_VERSION:-1.0}"
SCHEMA_MAJOR="v$(echo "${SPEC_VERSION}" | cut -d. -f1)"

# Derive effective paths. Full override chain lands in Phase 7.
SCHEMA_DIR="${PLUGIN_ROOT}/schema/${DOMAIN}/${SCHEMA_MAJOR}"
DOMAIN_DIR="${PLUGIN_ROOT}/domains/${DOMAIN}"
LANGUAGE_DIR="${PLUGIN_ROOT}/languages/${LANGUAGE}"
CODEGEN_DIR="${PLUGIN_ROOT}/codegen/${DOMAIN}-${LANGUAGE}"
LOCAL_SPECDEV="${PROJECT_ROOT}/.specdev"

echo "## Spec Context"
echo ""
echo "- Project root: ${PROJECT_ROOT}"
echo "- Domain: ${DOMAIN}"
echo "- Language: ${LANGUAGE}"
echo "- spec_version: ${SPEC_VERSION} (schema dir: ${SCHEMA_MAJOR})"
echo "- spec.toml: ${SPEC_TOML}"
echo "- Plugin root: ${PLUGIN_ROOT}"
[ -d "${LOCAL_SPECDEV}" ] && echo "- Local overrides: ${LOCAL_SPECDEV}"
echo ""
echo "## Resolved Paths"
echo ""
echo "- Schema:  ${SCHEMA_DIR}"
echo "- Domain:  ${DOMAIN_DIR}"
echo "- Language: ${LANGUAGE_DIR}"
echo "- Codegen: ${CODEGEN_DIR}"
echo ""
echo "_(Phase 1 scaffolding: plugin-defaults only. Override resolution lands in Phase 7.)_"
